knitr::opts_chunk$set(echo = TRUE)
year = 2025
crash_url = paste0('https://www.planecrashinfo.com/', year, '/', year, '.htm')
# the encoding came from class11
crash_page <- rvest::read_html(crash_url, encoding = "ISO-8859-1")
crash_page |>
# selector from inspector
#note the output (we also dropped the nth-child(8) in tr since we want all rows)
rvest::html_elements("tr > td:nth-child(1) > font") |>
rvest::html_text2() -> date_col
crash_page |>
# repeat for location operator
rvest::html_elements("tr > td:nth-child(2) > font") |>
rvest::html_text2() -> date_col
crash_page |>
# selector from inspector
#note the output (we also dropped the nth-child(8) in tr since we want all rows)
rvest::html_elements("tr > td:nth-child(1) > font") |>
rvest::html_text2() -> date_col
crash_page |>
# repeat for location operator
rvest::html_elements("tr > td:nth-child(2) > font") |>
rvest::html_text2() -> location_operator
crash_page |>
# repeat for aircraft_reg
rvest::html_elements("tr > td:nth-child(3) > font") |>
rvest::html_text2() -> aircraft_reg
crash_page |>
# repeat for fatalities
rvest::html_elements("tr > td:nth-child(4) > font") |>
rvest::html_text2() -> fatalities
# note that the number of elements in the four vectors are not equal
df = data.frame(
date_col = date_col,
# -1 drops the first row that had col header
location_operator = location_operator[-1],
aircraft_reg = aircraft_reg[-1],
fatalities = fatalities[-1]
)
df |>
tidyr::seperate(col = location_operator, into = c("location", "operator", sep = "\n")) |>
tidyr::seperate(col = aircraft_reg, into = c("aircraft", "registeration"), sep = "\n") |>
tidyr::seperate(col = fatalities, into = c("air_fatalities", "num_pass", "ground_fatalities")) -> tidy_df
df |>
tidyr::separate(col = location_operator, into = c("location", "operator", sep = "\n")) |>
tidyr::separate(col = aircraft_reg, into = c("aircraft", "registeration"), sep = "\n") |>
tidyr::separate(col = fatalities, into = c("air_fatalities", "num_pass", "ground_fatalities")) -> tidy_df
crash_clean = tidy_df |>
dplyr::mutate(
date = lubridate::dmy(date_col),
dplyr::across(c(air_fatalities, num_pass, ground_fatalities),
as.integer)
)
dplyr::glimpse(crash_clean)
