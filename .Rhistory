# for this example, only the first course
rvest::html_element("#sc_sccoursedescs > div:nth-child(1)") |>  rvest::html_text2()
chat$chat_structured(
isa125_text,
type = ellmer::type_object(
name = ellmer::type_string(
description = "Name of the course. For example, ISA 235. Information Technology and the Intelligent Enterprise. Do not include the parentehsis for the credit hour and do not end with a period"
),
description = ellmer::type_string(description = "The description of the course without the prereqs.")
)
)
